# 智能AI客服 · 配置模板（**入库**；真实值放 app.env，被 gitignore）
#
# 用法：cp app.env.example app.env 然后填真实值。
# 每条注明「留空 = 降级成什么」——**降级必须可见**（§14.4），不允许静默。
# 纪律：本文件只放占位符；**任何真实密钥/口令/私钥都不许出现在这里**。

# —— 基础 ——
APP_PORT=8080
APP_NAME=tickets
APP_DEBUG=0

# —— MySQL（业务库 + checkpoint 表同库；≥8.0.19 是 checkpoint saver 硬要求，勿升 9.x）——
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=tickets
DB_USERNAME=root
DB_PASSWORD=change-me            # 留空 = 连不上库，服务起不来

# —— Redis（答案缓存 / 限流 / 座位预占）——
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0                       # 留空 = 无答案缓存（缓存不写不读，走检索+生成）；限流放行

# —— 登录限流（与人无关的默认值可留空）——
LOGIN_RATE_LIMIT_WINDOW=1m
LOGIN_RATE_LIMIT_MAX_IP=10
LOGIN_RATE_LIMIT_MAX_USER=5

# —— 订单 ——
ORDER_EXPIRE_DURATION=15m
ORDER_EXPIRE_INTERVAL=1m
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/   # 留空 = 退化为周期扫描关单

# —— 鉴权（平台 JWT 自签；消费方只验签）——
TOKEN_SECRET_KEY=change-me       # 留空 = 无法签发/校验 token，登录不可用
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=24h

# —— 迁移 ——
MIGRATION_URL=file://internal/db/migration

# —— 支付（沙箱）——
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=             # 真实私钥请放 app.env；**若曾入库必须轮换**（见 docs/M4-实现报告.md）
ALIPAY_PUBLIC_KEY=
ALIPAY_IS_PRODUCTION=false
ALIPAY_NOTIFY_URL=http://127.0.0.1:8080/pay/alipay/notify
ALIPAY_RETURN_URL=http://127.0.0.1:8080/booking

# —— 智能AI客服：内网契约（Go ⇄ 编排层）——
INTERNAL_KEY=change-me           # 留空 = /internal/* 无保护（**仅限本机调试**，生产必须设）
PYTHON_BASE_URL=http://127.0.0.1:8001   # 留空 = /cs/ask 每轮降级为直接建单（启动会 ERROR 告警）

# —— 检索/嵌入（留空 = 字面替身 vector_mode=ngram，检索质量不代表真实水平）——
EMBEDDING_PROVIDER=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024
QDRANT_URL=http://127.0.0.1:16333
QDRANT_API_KEY=
QDRANT_COLLECTION=kb_chunks
KB_PATH=./kb
RELEVANCE_THRESHOLD_QA=0.60      # 未标定初值（19.1 选型后必须重标）
RELEVANCE_THRESHOLD_PROSE=0.50
LITERAL_THRESHOLD=3.0

# —— LLM（密钥只在 Go 网关侧；编排层只走网关）——
LLM_PROVIDER=mock                # mock = 确定性假模型，答案不代表真实生成质量（degraded.llm=true）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_MOCK_OPERATIONAL=true
RERANK_PROVIDER=
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# —— 工具层闸门（§8.2 / §19）——
PENALTY_SEMANTICS_CONFIRMED=0    # 0 = 退票费不下结论（FAQ + 转人工）；业务确认 12 行样例表后再置 1
GUEST_TICKET_ALLOWED=1           # 1 = 允许游客建单；置 0 = 引导登录

# —— 运维面（M4）——
ADMIN_ENABLED=0                  # 1 = 注册 /metrics 与 /admin/*（**必须有 ADMIN_TOKEN，否则拒绝启动**）
ADMIN_TOKEN=change-me            # 管理端 Bearer；用 openssl rand -hex 24 生成
CS_RATE_LIMIT_WINDOW=1m
CS_RATE_LIMIT_MAX_IP=30          # 成本保护值（非容量上限；压测后调整并在报告写明口径）
CS_RATE_LIMIT_MAX_USER=20

# —— 编排层（Python，独立进程）——
CHECKPOINT_DSN=mysql://root:change-me@127.0.0.1:3307/tickets  # 留空 = 无 checkpoint（等价单轮，多轮指代失效）
CHECKPOINT_RETENTION_DAYS=7
CHECKPOINT_CLEANUP_INTERVAL_S=3600
MEMORY_RECENT_N=5
MEMORY_SUMMARY_MAX=10
REWRITE_MAX=1
INTERRUPT_MAX=1
